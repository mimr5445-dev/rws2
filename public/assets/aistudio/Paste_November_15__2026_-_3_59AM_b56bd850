### `src/main.ts`
```ts
import './style.css';
import yaml from 'js-yaml';
import { DT, StudioEngine, TICK_RATE } from './core/engine';
import { ScenarioFile } from './core/types';
import { validateScenario } from './core/validator';
import { DEMO_ACTORS, DEMO_MAPS } from './packs/demoPacks';
import { SoundSynth } from './renderer/soundSynth';
import { StudioRenderer } from './renderer/studioRenderer';
import straitYaml from './scenarios/strait_crisis.scenario.yaml?raw';
import valleyYaml from './scenarios/valley_advance.scenario.yaml?raw';

const SCENARIOS: Record<string, { label: string; yaml: string }> = {
  strait: { label: 'أزمة المضيق (خريطة سياسية)', yaml: straitYaml },
  valley: { label: 'العبور التكتيكي (خريطة ميدان)', yaml: valleyYaml }
};

document.querySelector<HTMLDivElement>('#app')!.innerHTML = `
  <div class="layout">
    <aside class="sidebar">
      <h1>استوديو السيناريوهات التفاعلي</h1>
      <select id="presetSelect">
        <option value="strait">${SCENARIOS.strait.label}</option>
        <option value="valley">${SCENARIOS.valley.label}</option>
      </select>
      <div class="row">
        <button id="playBtn" class="active">إيقاف مؤقت</button>
        <button id="restartBtn">إعادة</button>
        <select id="speedSelect">
          <option value="1">1x</option>
          <option value="2">2x</option>
          <option value="0.5">0.5x</option>
        </select>
        <button id="recBtn">تسجيل فيديو</button>
      </div>
      <div class="badge">وضع اللعب الحر (اضغط على الخريطة للوضع أو التحريك):</div>
      <div class="row" id="sandboxBar">
        <button data-tool="select" class="active">تحديد / تحريك</button>
        <button data-tool="heavy_tank">+ دبابة</button>
        <button data-tool="infantry_squad">+ مشاة</button>
        <button data-tool="radar_outpost">+ رادار</button>
      </div>
      <div class="badge">ملف السيناريو YAML (عدّل أو اسحب ملف .yaml هنا):</div>
      <textarea id="yamlEditor"></textarea>
      <div class="row">
        <button id="applyBtn" class="active">تطبيق وفحص السيناريو</button>
      </div>
      <div id="errorBox"></div>
    </aside>
    <main class="stage-wrap">
      <div id="stageHost" class="stage-host"></div>
      <div id="captionBar" class="caption-bar" style="display:none"></div>
    </main>
  </div>
`;

const sound = new SoundSynth();
const renderer = new StudioRenderer();
const stageHost = document.getElementById('stageHost')!;
const yamlEditor = document.getElementById('yamlEditor') as HTMLTextAreaElement;
const errorBox = document.getElementById('errorBox')!;
const captionBar = document.getElementById('captionBar')!;

let engine: StudioEngine;
let playing = true;
let speed = 1;
let activeTool = 'select';
let sandboxCounter = 1;
let recorder: MediaRecorder | null = null;

async function loadFromYaml(rawYaml: string) {
  errorBox.innerHTML = '';
  try {
    const parsed = yaml.load(rawYaml) as ScenarioFile;
    const map = DEMO_MAPS[parsed?.meta?.map];
    const issues = validateScenario(parsed, map, DEMO_ACTORS);
    if (issues.length > 0) {
      errorBox.innerHTML = `<div class="err">${issues.map((i) => `• [${i.field}] ${i.message}`).join('<br>')}</div>`;
      return;
    }
    engine = new StudioEngine(map, DEMO_ACTORS, parsed);
    engine.onSound((id) => sound.play(id));
    await renderer.loadEngineAssets(engine);
  } catch (err) {
    errorBox.innerHTML = `<div class="err">خطأ YAML: ${(err as Error).message}</div>`;
  }
}

await renderer.init(stageHost);
yamlEditor.value = SCENARIOS.strait.yaml;
await loadFromYaml(yamlEditor.value);

// تفاعل الماوس (اللعب الحر)
renderer.onMapClick = (pt, hitId) => {
  if (!engine) return;
  if (activeTool === 'select') {
    if (hitId) {
      renderer.selectedEntityId = hitId;
    } else if (renderer.selectedEntityId) {
      engine.dispatchOrder({ type: 'move', entityId: renderer.selectedEntityId, to: pt });
    }
  } else {
    const act = DEMO_ACTORS[activeTool];
    const id = `sb_${sandboxCounter++}`;
    if (act.kind === 'building') {
      engine.dispatchOrder({ type: 'construct', id, actorId: act.id, at: pt, faction: 'blue', durationSec: 1.8 });
    } else {
      engine.dispatchOrder({ type: 'spawn', id, actorId: act.id, at: pt, faction: 'blue' });
      renderer.selectedEntityId = id;
    }
  }
};

// أدوات التحكم
document.getElementById('presetSelect')!.addEventListener('change', async (e) => {
  const key = (e.target as HTMLSelectElement).value;
  yamlEditor.value = SCENARIOS[key].yaml;
  await loadFromYaml(yamlEditor.value);
});

const playBtn = document.getElementById('playBtn')!;
playBtn.addEventListener('click', () => {
  playing = !playing;
  playBtn.textContent = playing ? 'إيقاف مؤقت' : 'تشغيل';
});

document.getElementById('restartBtn')!.addEventListener('click', () => engine?.reset());
document.getElementById('speedSelect')!.addEventListener('change', (e) => {
  speed = parseFloat((e.target as HTMLSelectElement).value);
});
document.getElementById('applyBtn')!.addEventListener('click', () => loadFromYaml(yamlEditor.value));

document.querySelectorAll('#sandboxBar button').forEach((btn) => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('#sandboxBar button').forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    activeTool = btn.getAttribute('data-tool')!;
  });
});

// سحب وإفلات ملفات .yaml أو صور خرائط مخصصة
stageHost.addEventListener('dragover', (e) => e.preventDefault());
stageHost.addEventListener('drop', async (e) => {
  e.preventDefault();
  const file = e.dataTransfer?.files[0];
  if (!file) return;
  if (file.name.endsWith('.yaml') || file.name.endsWith('.yml')) {
    yamlEditor.value = await file.text();
    await loadFromYaml(yamlEditor.value);
  } else if (file.type.startsWith('image/')) {
    engine.map.svgOrUrl = URL.createObjectURL(file);
    await renderer.loadEngineAssets(engine);
  }
});

// تسجيل فيديو WebM نظيف
const recBtn = document.getElementById('recBtn')!;
recBtn.addEventListener('click', () => {
  if (recorder && recorder.state === 'recording') {
    recorder.stop();
    return;
  }
  const stream = renderer.app.canvas.captureStream(30);
  const chunks: Blob[] = [];
  recorder = new MediaRecorder(stream, { mimeType: 'video/webm' });
  recorder.ondataavailable = (e) => e.data.size && chunks.push(e.data);
  recorder.onstop = () => {
    renderer.hideUIHelpers = false;
    recBtn.textContent = 'تسجيل فيديو';
    recBtn.classList.remove('danger');
    const url = URL.createObjectURL(new Blob(chunks, { type: 'video/webm' }));
    const a = document.createElement('a');
    a.href = url;
    a.download = 'scenario-export.webm';
    a.click();
  };
  renderer.hideUIHelpers = true;
  recorder.start();
  recBtn.textContent = 'إيقاف وحفظ الفيديو';
  recBtn.classList.add('danger');
});

// حلقة المحاكاة الثابتة + التنعيم
let accumulator = 0;
let lastTime = performance.now();
function loop(now: number) {
  const frameDt = Math.min(0.1, (now - lastTime) / 1000);
  lastTime = now;

  if (engine && playing) {
    accumulator += frameDt * speed;
    while (accumulator >= DT) {
      engine.step();
      accumulator -= DT;
    }
  }

  if (engine) {
    const alpha = playing ? accumulator / DT : 1;
    renderer.render(engine, alpha, now / 1000);
    captionBar.style.display = engine.caption ? 'block' : 'none';
    captionBar.textContent = engine.caption;
  }
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);

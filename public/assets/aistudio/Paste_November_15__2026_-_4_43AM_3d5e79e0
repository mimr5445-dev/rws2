function attachEngineEvents(eng: StudioEngine) {
  eng.onSound((id) => sound.play(id));
  eng.onMoveBlocked((ent) => {
    const msg =
      ent.domain === 'land'
        ? '⚠️ لا يوجد مسار بري متصل — الدبابات والمشاة لا تعبر البحر!'
        : '⚠️ لا يوجد مسار بحري متصل — السفن لا تعبر اليابسة!';
    showToast(msg);
  });
}

async function enterCountryProvinces(regionId: string) {
  if (!engine?.map.regions) return;
  const reg = engine.map.regions[regionId];
  if (!reg?.iso3) return;

  const title = reg.nameAr ? `${reg.nameAr} (${reg.name})` : reg.name;
  document.getElementById('geoHoverLabel')!.textContent = `⏳ جاري تجهيز محافظات ${title}...`;
  renderer.focusRegion(engine, regionId);

  try {
    const countryMap = await buildCountryProvincesMapPack(reg.iso3, title);
    registry.maps[countryMap.id] = countryMap;
    // سيناريو نظيف مهيأ على خريطة الدولة لتجربة الأدوات والذكاء الاصطناعي فورًا
    const firstAnchor = Object.keys(countryMap.anchors)[0];
    const starterYaml = `meta:\n  title: "${countryMap.title}"\n  map: ${countryMap.id}\ntimeline:\n  - at: 0s\n    caption: { text: "خريطة ${title} جاهزة — اختر وحدة وحرّكها بين المحافظات أو انسخ Prompt للـ AI" }${
      firstAnchor ? `\n    pulse: { at: ${firstAnchor}, color: "#38bdf8", radius: 65 }` : ''
    }\n`;
    yamlEditor.value = starterYaml;
    await loadFromYaml(starterYaml);

    document.getElementById('geoBreadcrumb')!.textContent = `🌍 العالم ◂ ${title}`;
    document.getElementById('geoHoverLabel')!.textContent = `عدد المحافظات/المناطق: ${Object.keys(countryMap.zones).length}`;
    document.getElementById('drillDownBtn')!.style.display = 'none';
    document.getElementById('backWorldBtn')!.style.display = 'inline-block';
  } catch (err) {
    showToast((err as Error).message);
  }
}

renderer.onRegionHover = (regionId) => {
  const lbl = document.getElementById('geoHoverLabel')!;
  if (!regionId || !engine?.map.regions?.[regionId]) {
    lbl.textContent = engine?.map.geoLevel === 'world' ? 'مرّر على دولة للتحديد، وانقر مرتين للدخول للمحافظات' : 'مرّر على محافظة لتحديدها';
    return;
  }
  const r = engine.map.regions[regionId];
  lbl.textContent = r.nameAr ? `${r.nameAr} (${r.name})` : r.name;
};

renderer.onRegionDoubleClick = async (regionId) => {
  if (engine?.map.geoLevel === 'world') {
    await enterCountryProvinces(regionId);
  }
};

document.getElementById('drillDownBtn')!.addEventListener('click', () => {

let accumulator = 0;
let lastTime = performance.now();
function loop(now: number) {
  const frameDt = Math.min(0.1, (now - lastTime) / 1000);
  lastTime = now;

  if (engine && playing) {
    accumulator += frameDt * speed;
    while (accumulator >= DT) {
      engine.step();
      accumulator -= DT;
    }
  }

  if (actionRecorder.isRecording) {
    document.getElementById('recClock')!.textContent = `${actionRecorder.elapsedSec().toFixed(1)}s`;
    document.getElementById('recCount')!.textContent = String(actionRecorder.steps.length);
  }

  if (engine) {
    const alpha = playing ? accumulator / DT : 1;
    renderer.render(engine, alpha, now / 1000);
    captionBar.style.display = engine.caption ? 'block' : 'none';
    captionBar.textContent = engine.caption;
    if (playing) {
      scrubber.value = String(Math.min(parseInt(scrubber.max, 10), engine.tick));
      timeLabel.textContent = `${(engine.tick * DT).toFixed(1)}s`;
    }
  }
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);

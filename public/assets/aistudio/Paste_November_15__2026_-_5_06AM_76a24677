async function loadFromYaml(rawYaml: string, saveScenarioId?: string) {
  statusBox.innerHTML = '';
  try {
    const parsed = yaml.load(rawYaml) as ScenarioFile;
    const map = registry.maps[parsed?.meta?.map];
    const issues = validateScenario(parsed, map, registry.actors);
    if (issues.length > 0) {
      statusBox.innerHTML = `<div class="err">${issues.map((i) => `• [${i.field}] ${i.message}`).join('<br>')}</div>`;
      return false;
    }
    engine = new StudioEngine(map, registry.actors, parsed);
    attachEngineEvents(engine);
    await renderer.loadEngineAssets(engine);
    updateGeoHud(map);
    refreshMapDropdown(map.id);
    const maxTicks = Math.ceil(engine.estimateDurationSec() * TICK_RATE);
    scrubber.max = String(maxTicks);
    durLabel.textContent = `${(maxTicks / TICK_RATE).toFixed(1)}s`;
    await studioDb.setSetting('lastMapId', map.id);
    if (saveScenarioId) await studioDb.setSetting('lastScenarioId', saveScenarioId);
    return true;
  } catch (err) {
    statusBox.innerHTML = `<div class="err">خطأ YAML: ${(err as Error).message}</div>`;
    return false;
  }
}


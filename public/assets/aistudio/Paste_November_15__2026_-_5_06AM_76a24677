renderer.onMapClick = (pt, hitId) => {
  if (!engine) return;

  if (renderer.editorOverlay.enabled) {
    if (mapTool === 'anchor') {
      const rawName = (document.getElementById('pointNameInput') as HTMLInputElement).value.trim() || `pt_${Object.keys(engine.map.anchors).length + 1}`;
      engine.map.anchors[rawName] = { x: Math.round(pt.x), y: Math.round(pt.y), label: rawName };
      renderer.refreshAnchors(engine.map);
      packStatusBox.innerHTML = `<div class="ok">تمت إضافة المرسى: ${rawName}</div>`;
    } else if (mapTool === 'zone') {
      renderer.editorOverlay.draftZonePoints.push({ x: Math.round(pt.x), y: Math.round(pt.y) });
    } else {
      renderer.onMapPaint?.(pt);
    }
    return;
  }

  if (pendingActionMode === 'arrow_start') {
    arrowStartPt = pt;
    pendingActionMode = 'arrow_end';
    showToast('الآن اضغط نقطة نهاية السهم');
    return;
  }
  if (pendingActionMode === 'arrow_end' && arrowStartPt) {
    const id = `arr_${Date.now()}`;
    engine.arrows.set(id, { id, from: arrowStartPt, to: pt, color: '#f59e0b', dashed: true, progress: 0, rate: 0.8 });
    actionRecorder.recordArrow(id, arrowStartPt, pt, '#f59e0b', true);
    pendingActionMode = 'none';
    arrowStartPt = null;
    return;
  }
  if (pendingActionMode === 'pulse') {
    engine.pulses.push({ x: pt.x, y: pt.y, color: '#ef4444', maxRadius: 70, progress: 0 });
    actionRecorder.recordPulse(pt, '#ef4444');
    pendingActionMode = 'none';
    return;
  }

  if (activeTool === 'select') {
    if (hitId) {
      renderer.selectedEntityId = hitId;
    } else if (renderer.selectedEntityId) {
      engine.dispatchOrder({ type: 'move', entityId: renderer.selectedEntityId, to: pt });
      actionRecorder.recordMove(renderer.selectedEntityId, pt);
    } else if (engine.map.hitTest) {
      const regId = engine.map.hitTest(pt);
      renderer.selectedRegionId = regId;
      const drillBtn = document.getElementById('drillDownBtn')!;
      if (regId && engine.map.geoLevel === 'world' && engine.map.regions?.[regId]) {
        const r = engine.map.regions[regId];
        drillBtn.textContent = `دخول إلى محافظات ${r.nameAr ?? r.name} ↗`;
        drillBtn.style.display = 'inline-block';
      } else {
        drillBtn.style.display = 'none';
      }
    }
  } else {
    const act = registry.actors[activeTool];
    const id = `sb_${sandboxCounter++}`;
    if (act.kind === 'building') {
      engine.dispatchOrder({ type: 'construct', id, actorId: act.id, at: pt, faction: 'blue', durationSec: 1.8 });
      actionRecorder.recordConstruct(id, act.id, pt, 'blue', 1.8);
    } else {
      engine.dispatchOrder({ type: 'spawn', id, actorId: act.id, at: pt, faction: 'blue' });
      actionRecorder.recordSpawn(id, act.id, pt, 'blue');
      renderer.selectedEntityId = id;
    }
  }
};


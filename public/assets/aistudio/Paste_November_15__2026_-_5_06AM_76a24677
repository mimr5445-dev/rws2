function paintNavCell(pt: Point, cellVal: NavCell) {
  if (!engine) return;
  const gx = Math.floor(pt.x / engine.map.cellSize);
  const gy = Math.floor(pt.y / engine.map.cellSize);
  for (let dy = -1; dy <= 1; dy++) {
    for (let dx = -1; dx <= 1; dx++) {
      const nx = gx + dx, ny = gy + dy;
      if (nx >= 0 && ny >= 0 && nx < engine.map.cols && ny < engine.map.rows) {
        engine.map.navGrid[ny * engine.map.cols + nx] = cellVal;
      }
    }
  }
}

renderer.onMapPaint = (pt) => {
  if (mapTool === 'paint_land') paintNavCell(pt, 0);
  if (mapTool === 'paint_sea') paintNavCell(pt, 1);
  if (mapTool === 'paint_block') paintNavCell(pt, 2);
};


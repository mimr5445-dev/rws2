});
document.getElementById('applyBtn')!.addEventListener('click', () => loadFromYaml(yamlEditor.value));

// سحب وإفلات ملفات السيناريو أو الحزم .pack.yaml
stageHost.addEventListener('dragover', (e) => e.preventDefault());
stageHost.addEventListener('drop', async (e) => {
  e.preventDefault();
  const file = e.dataTransfer?.files[0];
  if (!file) return;
  const text = await file.text();
  if (file.name.endsWith('.pack.yaml') || file.name.endsWith('.pack.yml')) {
    const bundle = yaml.load(text) as PackBundle;
    const res = registry.importBundle(bundle);
    rebuildSandboxButtons();
    statusBox.innerHTML = `<div class="ok">تم استيراد ${res.mapsAdded} خريطة و ${res.actorsAdded} كيان</div>`;
  } else if (file.name.endsWith('.yaml') || file.name.endsWith('.yml')) {
    yamlEditor.value = text;
    await loadFromYaml(text);
  }
});

// تسجيل فيديو مع الصوت الداخلي
const recBtn = document.getElementById('recBtn')!;
recBtn.addEventListener('click', () => {
  if (recorder && recorder.state === 'recording') {
    recorder.stop();
    return;
  }
  const vStream = renderer.app.canvas.captureStream(30);
  const aStream = sound.getAudioStream();
  const tracks = [...vStream.getVideoTracks(), ...(aStream ? aStream.getAudioTracks() : [])];
  const combined = new MediaStream(tracks);
  const chunks: Blob[] = [];
  recorder = new MediaRecorder(combined, { mimeType: 'video/webm' });
  recorder.ondataavailable = (e) => e.data.size && chunks.push(e.data);
  recorder.onstop = () => {
    renderer.hideUIHelpers = false;
    recBtn.textContent = 'تسجيل فيديو';
    recBtn.classList.remove('danger');
    const url = URL.createObjectURL(new Blob(chunks, { type: 'video/webm' }));
    const a = document.createElement('a');
    a.href = url;
    a.download = 'studio-export.webm';
    a.click();
  };
  renderer.hideUIHelpers = true;
  recorder.start();
  recBtn.textContent = 'إيقاف وحفظ الفيديو';
  recBtn.classList.add('danger');
});

let accumulator = 0;
let lastTime = performance.now();
function loop(now: number) {
  const frameDt = Math.min(0.1, (now - lastTime) / 1000);
  lastTime = now;

  if (engine && playing) {
    accumulator += frameDt * speed;
    while (accumulator >= DT) {
      engine.step();
      accumulator -= DT;
    }
  }

  if (engine) {
    const alpha = playing ? accumulator / DT : 1;
    renderer.render(engine, alpha, now / 1000);
    captionBar.style.display = engine.caption ? 'block' : 'none';
    captionBar.textContent = engine.caption;
    if (playing) {
      scrubber.value = String(Math.min(parseInt(scrubber.max, 10), engine.tick));
      timeLabel.textContent = `${(engine.tick * DT).toFixed(1)}s`;
    }
  }
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);

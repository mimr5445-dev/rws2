function rebuildSandboxButtons() {
  const bar = document.getElementById('sandboxBar')!;
  bar.innerHTML = `<button data-tool="select" class="${activeTool === 'select' ? 'active' : ''}">تحديد / تحريك</button>`;
  for (const act of Object.values(registry.actors)) {
    bar.innerHTML += `<button data-tool="${act.id}" class="${activeTool === act.id ? 'active' : ''}">+ ${act.label}</button>`;
  }
  bar.querySelectorAll('button').forEach((btn) => {
    btn.addEventListener('click', () => {
      activeTool = btn.getAttribute('data-tool')!;
      rebuildSandboxButtons();
    });
  });
}

async function loadFromYaml(rawYaml: string) {
  statusBox.innerHTML = '';
  try {
    const parsed = yaml.load(rawYaml) as ScenarioFile;
    const map = registry.maps[parsed?.meta?.map];
    const issues = validateScenario(parsed, map, registry.actors);
    if (issues.length > 0) {
      statusBox.innerHTML = `<div class="err">${issues.map((i) => `• [${i.field}] ${i.message}`).join('<br>')}</div>`;
      return;
    }
    engine = new StudioEngine(map, registry.actors, parsed);
    engine.onSound((id) => sound.play(id));
    await renderer.loadEngineAssets(engine);
    const maxTicks = Math.ceil(engine.estimateDurationSec() * TICK_RATE);
    scrubber.max = String(maxTicks);
    durLabel.textContent = `${(maxTicks / TICK_RATE).toFixed(1)}s`;
  } catch (err) {
    statusBox.innerHTML = `<div class="err">خطأ YAML: ${(err as Error).message}</div>`;
  }
}

function paintNavCell(pt: Point, cellVal: NavCell) {
  if (!engine) return;
  const gx = Math.floor(pt.x / engine.map.cellSize);
  const gy = Math.floor(pt.y / engine.map.cellSize);
  for (let dy = -1; dy <= 1; dy++) {
    for (let dx = -1; dx <= 1; dx++) {
      const nx = gx + dx, ny = gy + dy;
      if (nx >= 0 && ny >= 0 && nx < engine.map.cols && ny < engine.map.rows) {
        engine.map.navGrid[ny * engine.map.cols + nx] = cellVal;
      }
    }
  }
}

